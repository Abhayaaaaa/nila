{
  "name": "nila-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler pages dev public",
    "deploy": "wrangler pages deploy public",
    "db:create": "wrangler d1 create nila-reports",
    "db:init": "wrangler d1 execute nila-reports --remote --file=./schema.sql",
    "db:init-local": "wrangler d1 execute nila-reports --local --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
